ENVIRONMENT=development

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# PostgreSQL доп настройки
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10
POSTGRES_ECHO=false
# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=supersecretpgadmin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=secret
# Redis доп настройки
REDIS_MAX_CONNECTIONS=20


# Авторизация
AUTH_JWKS_URL=http://auth-dev:8000/.well-known/jwks.json
AUTH_ISSUER=https://yournameauth.service.com
AUTH_ALGORITHM=RS256
AUTH_JWKS_CACHE_TTL_SECONDS=1800

# CORS
CORS_ORIGINS=["http://localhost:8081","http://localhost:3000"]
# или для SaaS
# CORS_ORIGIN_REGEX=https://.*\.myapp\.com

# RabbitMQ
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_VIERTUAL_HOST=/
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest

# S3 настройки для подключения к облачному хранилищу yandex storage
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION_NAME=ru-central1
S3_AWS_ACCESS_KEY_ID=secret
S3_AWS_SECRET_ACCESS_KEY=secret
S3_BUCKET_NAME=bucker_name